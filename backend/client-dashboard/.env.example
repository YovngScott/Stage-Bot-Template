# ============================================================================
# Dashboard de cliente (Stage AI Labs) — variables de entorno
# Copia este archivo a `.env` y complétalo. Cada cliente se despliega con el
# MISMO código pero estas variables distintas; el backend y el Supabase son
# COMPARTIDOS por todos los clientes.
# ============================================================================

# Supabase del proyecto de MENSAJERÍA (compartido). Usar SOLO la anon/publishable
# key: es pública por diseño (va en el bundle del navegador). El aislamiento
# entre clientes lo hace RLS + la tabla tenant_admins, no el secreto de la clave.
VITE_SUPABASE_URL=https://vulyyztktylldfnuvzbn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
# Alias aceptado si prefieres ese nombre:
# VITE_SUPABASE_ANON_KEY=eyJ...

# Slug de ESTE cliente (debe coincidir con config/tenants/<slug>.json del backend).
VITE_TENANT_SLUG=mi-cliente
# En un build compartido también se puede abrir con ?tenant=mi-cliente

# App de Fly dedicada de este cliente (una por cliente). El Owner Console añade
# ?api=https://stage-<slug>-<kind>.fly.dev; esta es el valor por defecto.
VITE_API_URL=https://stage-mi-cliente-messaging.fly.dev
